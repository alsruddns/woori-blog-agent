{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://woori.local/schemas/content-import/1.0",
  "title": "Woori content import envelope",
  "description": "Manual import envelope accepted by the API. The item is untrusted, remains review-held, and cannot authorize publication.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "submitted_by",
    "item"
  ],
  "properties": {
    "submitted_by": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "content_id",
        "event_group_id",
        "relation",
        "source_region",
        "language_code",
        "target_audiences",
        "title",
        "body_markdown",
        "category",
        "google_trends_based",
        "source_ids",
        "sources",
        "claims",
        "fact_checked_at",
        "seo",
        "blogger_labels",
        "generation_method",
        "generated_at",
        "created_by"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "content_id": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        },
        "event_group_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128
        },
        "research_package_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "parent_content_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "relation": {
          "enum": [
            "original",
            "localized",
            "revision"
          ]
        },
        "source_region": {
          "type": "string",
          "pattern": "^([A-Z]{2,3}|[0-9]{3})$"
        },
        "language_code": {
          "enum": [
            "ko",
            "en",
            "ja",
            "zh-CN"
          ]
        },
        "target_audiences": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "language_code",
              "reader_relevance_reason"
            ],
            "properties": {
              "language_code": {
                "enum": [
                  "ko",
                  "en",
                  "ja",
                  "zh-CN"
                ]
              },
              "target_region": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reader_relevance_reason": {
                "type": "string",
                "minLength": 10,
                "maxLength": 1000
              }
            }
          }
        },
        "title": {
          "type": "string",
          "minLength": 5,
          "maxLength": 200
        },
        "body_markdown": {
          "type": "string",
          "minLength": 100,
          "maxLength": 100000,
          "description": "Raw HTML is rejected. Markdown is stored as text and is never executed."
        },
        "category": {
          "enum": [
            "economy",
            "finance",
            "stocks",
            "crypto",
            "technology",
            "semiconductors",
            "artificial-intelligence",
            "policy",
            "entertainment"
          ]
        },
        "google_trends_based": {
          "type": "boolean"
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_id",
              "title",
              "organization",
              "url",
              "observed_at",
              "language_code",
              "source_type",
              "rights_status",
              "rights_note"
            ],
            "properties": {
              "source_id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "organization": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://"
              },
              "published_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "observed_at": {
                "type": "string",
                "format": "date-time"
              },
              "language_code": {
                "type": "string"
              },
              "source_type": {
                "enum": [
                  "government",
                  "regulatory",
                  "filing",
                  "company",
                  "academic",
                  "statistical",
                  "news",
                  "other"
                ]
              },
              "rights_status": {
                "enum": [
                  "public_domain",
                  "open_license",
                  "permission_confirmed",
                  "quotation_review_required",
                  "unknown"
                ]
              },
              "rights_note": {
                "type": "string",
                "minLength": 5
              }
            }
          }
        },
        "claims": {
          "type": "array",
          "minItems": 1,
          "maxItems": 80,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "claim_id",
              "claim",
              "source_ids",
              "evidence_excerpt",
              "verification_status",
              "factual_state"
            ],
            "properties": {
              "claim_id": {
                "type": "string"
              },
              "claim": {
                "type": "string",
                "minLength": 8
              },
              "source_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "evidence_excerpt": {
                "type": "string",
                "minLength": 8
              },
              "verification_status": {
                "enum": [
                  "source_span_verified",
                  "corroborated",
                  "conflict",
                  "unverified"
                ]
              },
              "factual_state": {
                "enum": [
                  "proposed",
                  "planned",
                  "approved",
                  "enacted",
                  "paid",
                  "unverified"
                ]
              }
            }
          }
        },
        "fact_checked_at": {
          "type": "string",
          "format": "date-time"
        },
        "seo": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "search_intent",
            "primary_terms",
            "related_terms",
            "seo_title",
            "search_description",
            "core_question",
            "core_answer"
          ],
          "properties": {
            "search_intent": {
              "type": "string"
            },
            "primary_terms": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10,
              "items": {
                "type": "string"
              }
            },
            "related_terms": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "string"
              }
            },
            "seo_title": {
              "type": "string"
            },
            "search_description": {
              "type": "string"
            },
            "core_question": {
              "type": "string"
            },
            "core_answer": {
              "type": "string"
            }
          }
        },
        "blogger_labels": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 40
          }
        },
        "generation_method": {
          "enum": [
            "manual_codex_import",
            "chatgpt_scheduled_export",
            "other_external_export"
          ]
        },
        "model_name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "created_by": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        }
      }
    }
  }
}
